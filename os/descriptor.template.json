{
  "schemaVersion": 2,
  "id": "imbatranim-office",
  "name": "Office",
  "description": "Office apps built and installed together.",
  "source": {
    "repo": "https://github.com/gandolh/imbatranim-office",
    "ref": "PIN-A-FULL-40-HEX-COMMIT-OF-THIS-REPO"
  },
  "type": "static",
  "runtime": "native",
  "sharedKit": 1,
  "build": {
    "install": ["npm", "ci"],
    "command": ["npm", "run", "build:os"],
    "output": "dist/os"
  },
  "apps": [
    {
      "id": "office-docs",
      "name": "Docs",
      "description": "Edit documents (docx)",
      "meta": ["docs", "document", "word", "docx", "text", "editor", "write"],
      "entry": "docs/app.mjs",
      "window": {
        "defaultSize": {
          "w": 860,
          "h": 680
        },
        "minSize": {
          "w": 480,
          "h": 380
        }
      },
      "icon": "file-text",
      "opens": ["docx"],
      "multiInstance": true,
      "capabilities": ["fs", "intents", "notify"],
      "styles": ["docs/app.css", "docs/superdoc.css"]
    },
    {
      "id": "office-cad",
      "name": "CAD",
      "description": "2D drafting: DXF drawings with a command line, object snaps and layers.",
      "meta": ["office", "cad", "dxf", "drafting"],
      "entry": "cad/app.mjs",
      "window": {
        "defaultSize": {
          "w": 1100,
          "h": 720
        },
        "minSize": {
          "w": 700,
          "h": 440
        }
      },
      "icon": "drafting-compass",
      "opens": ["dxf"],
      "multiInstance": true,
      "capabilities": ["fs", "intents", "notify", "shortcuts"],
      "styles": ["cad/app.css"]
    },
    {
      "id": "office-slides",
      "name": "Slides",
      "description": "Open, edit and present PowerPoint presentations",
      "meta": [
        "slides",
        "powerpoint",
        "pptx",
        "presentation",
        "deck",
        "present",
        "notes",
        "office"
      ],
      "entry": "slides/app.mjs",
      "window": {
        "defaultSize": {
          "w": 960,
          "h": 560
        },
        "minSize": {
          "w": 620,
          "h": 380
        }
      },
      "icon": "presentation",
      "opens": ["pptx"],
      "multiInstance": true,
      "capabilities": ["fs", "intents", "notify", "shortcuts"],
      "styles": ["slides/app.css"]
    },
    {
      "id": "office-sheets",
      "name": "Sheets",
      "description": "Edit spreadsheets (xlsx, csv)",
      "meta": ["sheets", "spreadsheet", "excel", "xlsx", "csv", "grid", "table", "formula"],
      "entry": "sheets/app.mjs",
      "window": {
        "defaultSize": {
          "w": 900,
          "h": 560
        },
        "minSize": {
          "w": 600,
          "h": 380
        }
      },
      "icon": "table",
      "opens": ["xlsx", "xls", "csv"],
      "multiInstance": true,
      "capabilities": ["fs", "intents", "notify"],
      "styles": ["sheets/app.css", "sheets/univer.css"]
    },
    {
      "id": "office-pdf",
      "name": "PDF",
      "description": "Read, annotate, fill in, sign and organise PDF documents",
      "meta": ["pdf", "document", "read", "reader", "view", "search", "annotate", "forms", "sign"],
      "entry": "pdf/app.mjs",
      "window": {
        "defaultSize": {
          "w": 1040,
          "h": 560
        },
        "minSize": {
          "w": 680,
          "h": 420
        }
      },
      "icon": "file-pen",
      "opens": ["pdf"],
      "multiInstance": true,
      "capabilities": ["fs", "intents", "notify"],
      "styles": ["pdf/app.css"]
    }
  ],
  "minSystemVersion": 2
}
